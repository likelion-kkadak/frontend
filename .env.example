# 개발 서버의 /api 프록시 대상. 팀 공용 배포 BE(Render)를 기본으로 둠
# BE를 로컬에서 직접 띄울 때만 http://localhost:3001 로 바꾼다 (값을 지우면 이 주소를 씀)
VITE_API_PROXY_TARGET=https://ggadak.onrender.com

# 프록시 없이 BE Origin을 직접 호출할 때만 설정 (비워 두면 같은 Origin의 /api 사용)
VITE_API_BASE_URL=

# 봇 초대 링크 (API에 없음). 설정하면 연결 설정 화면에 "봇 초대" 버튼이 나타남
VITE_DISCORD_BOT_INVITE_URL=

# BE가 구현한 "FE 요청 API"(명세 10장) 이름을 쉼표로 나열. all = 전부
#   decisionDelete, decisionStatus, decisionEditExtra, listFilters, multiStatus, approvals, botInvite
# BE가 구현했다고 한 것 중 배포 BE에서 실패가 확인된 것은 뺀 값 (README "기능 플래그" 참고)
VITE_PROPOSED_APIS=decisionDelete,decisionStatus,listFilters,approvals
