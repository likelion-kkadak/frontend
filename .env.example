# 개발 서버의 /api 프록시 대상 (기본값: http://localhost:3001)
VITE_API_PROXY_TARGET=http://localhost:3001

# 프록시 없이 BE Origin을 직접 호출할 때만 설정 (비워 두면 같은 Origin의 /api 사용)
VITE_API_BASE_URL=

# 봇 초대 링크 (API에 없음). 설정하면 연결 설정 화면에 "봇 초대" 버튼이 나타남
VITE_DISCORD_BOT_INVITE_URL=

# BE가 구현한 "FE 요청 API"(명세 10장) 이름을 쉼표로 나열. all = 전부
#   decisionDelete, decisionStatus, decisionEditExtra, listFilters, multiStatus, approvals, botInvite
VITE_PROPOSED_APIS=
